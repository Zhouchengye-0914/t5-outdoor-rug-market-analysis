# ===== 数据源配置 =====
# 原始 Excel 文件相对路径（相对项目根目录）
RAW_EXCEL_PATH=data/raw/地垫-卖家精灵市场数据.xlsx

# ===== 数据库配置 =====
# SQLite 数据库路径
DATABASE_URL=sqlite:///data/processed/market.db

# ===== 转换配置 =====
# 是否覆盖已存在的数据库（true/false）
IMPORT_OVERWRITE=true
# 预留配置：当前版本尚未实现，修改此值不会改变转换行为
# 数值列出现异常时的容差：0=严格；1=宽松
IMPORT_NUMERIC_TOLERANCE=1

# ===== 日志 =====
LOG_LEVEL=info
