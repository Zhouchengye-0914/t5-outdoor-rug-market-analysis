{
  "name": "t5-market-import",
  "version": "1.0.0",
  "description": "Excel -> SQLite converter for outdoor rug market data",
  "main": "src/import_xlsx.js",
  "scripts": {
    "import:base": "node src/import_xlsx.js",
    "build:competitor": "node src/build_competitor_db.js",
    "apply:competitor": "node src/apply_competitor_2026.js",
    "import": "npm run import:base && npm run build:competitor && npm run apply:competitor",
    "verify": "node tests/verify.js",
    "audit": "node tests/full_audit.js",
    "audit:competitor": "node tests/competitor_audit.js",
    "audit:plan-reference": "node tests/plan_reference_audit.js",
    "test:overwrite": "node tests/overwrite_guard.js",
    "test:analysis": "node src/analyze_market.js && node tests/analysis_audit.js",
    "test": "npm run verify && npm run audit && npm run audit:competitor && npm run audit:plan-reference && npm run test:analysis && npm run test:frontend && npm run test:overwrite",
    "analyze": "node src/analyze_market.js",
    "poc": "node sandbox/test_xlsx.js",
    "test:frontend": "node tests/frontend_audit.js"
  },
  "dependencies": {
    "xlsx": "^0.18.5",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "ISC"
}
