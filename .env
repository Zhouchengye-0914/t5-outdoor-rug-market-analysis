# ===== 数据源配置 =====
# 原始 Excel 文件相对路径（相对项目根目录）
RAW_EXCEL_PATH=data/raw/地垫-卖家精灵市场数据.xlsx

# ===== 数据库配置 =====
# SQLite 数据库路径
DATABASE_URL=sqlite:///data/processed/market.db

# ===== 转换配置 =====
# 是否覆盖已存在的数据库（true/false）
IMPORT_OVERWRITE=true
# ===== 日志 =====
LOG_LEVEL=info

# ===== 分析报告 =====
# 默认读取正式数据库；测试时可指向 tmp/market_optimized.db
ANALYSIS_DB_PATH=data/processed/market.db
# 2026.03-07 存在源数据口径突变，确认前仅分析到 2026.02
ANALYSIS_CUTOFF=202607
